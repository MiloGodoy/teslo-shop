# PostgreSQL local: coincide con docker-compose.yml
DB_USER=postgres
DB_NAME=teslo-shop
DB_PASSWORD=replace-with-a-local-password
POSTGRES_VOLUME_NAME=teslo-shop-postgres-data
POSTGRES_VOLUME_EXTERNAL=false
DATABASE_URL="postgresql://postgres:replace-with-a-local-password@localhost:5435/teslo-shop?schema=public"
DIRECT_URL="postgresql://postgres:replace-with-a-local-password@localhost:5435/teslo-shop?schema=public"

# Generar con: openssl rand -base64 32
AUTH_SECRET=
# Para probar next start en localhost. Vercel detecta su proxy automáticamente.
AUTH_TRUST_HOST=true
# URL pública definitiva. Local: http://localhost:3000
APP_URL=http://localhost:3000

# Copiar desde Cloudinary > Settings > API Keys. Solo servidor.
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Opcional, para crear el primer administrador con npm run db:init.
# No modifica cuentas existentes. Contraseña de 12 a 72 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: sin client ID el catálogo funciona y los pagos se muestran deshabilitados.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Obligatorio en live. ID de la cuenta comerciante que recibe el pago.
PAYPAL_MERCHANT_ID=
# ID del webhook PAYMENT.CAPTURE.COMPLETED que apunta a /api/paypal/webhook
PAYPAL_WEBHOOK_ID=
