{
  "name": "teslo-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "prisma:deploy": "npm run db:deploy",
    "seed": "node --import tsx src/seed/seed-database.ts",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:init": "node --import tsx scripts/init-database.ts",
    "check:images": "node --import tsx scripts/check-images.ts"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^8.9.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.2.0",
    "swiper": "^12.1.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.7",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat-alternates": "^5.3.0",
    "@next/env": "16.4.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "tsx": "^4"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
